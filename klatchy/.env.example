# klatchy server config
KLATCHY_JWT_SECRET=dev-secret-change-me-to-32-bytes-minimum
KLATCHY_DATABASE_URL=postgresql+asyncpg://klatchy:klatchy@localhost:5432/klatchy
KLATCHY_REDIS_URL=redis://localhost:6379/0
KLATCHY_BIND_HOST=0.0.0.0
KLATCHY_BIND_PORT=8787

# GitHub OAuth (https://github.com/settings/developers — "Device flow" enabled)
KLATCHY_GITHUB_CLIENT_ID=
KLATCHY_GITHUB_CLIENT_SECRET=

# Local-test bypass — lets `klatchy --dev-login HANDLE` skip GitHub.
# NEVER enable in prod.
KLATCHY_DEV_LOGIN=true

# Client config (env overrides)
KLATCHY_SERVER_URL=ws://localhost:8787
KLATCHY_API_URL=http://localhost:8787
