{
  "name": "@klatchy/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/bin.js",
  "types": "dist/bin.d.ts",
  "bin": {
    "klatchy": "dist/bin.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
